              "terminology_key": "work.stage",
              "completion_mode": "all_children",
              "depends_on": [
                "proposal_stage"
              ],
              "metadata": {
                "color": "#d97706"
              },
              "children": [
                {
                  "id": "sign_sales_proposal",
                  "title": "Get signature",
                  "terminology_key": "work.task",
                  "actionable": true,
                  "show_in_todo_list": true,
                  "automation_bindings": {
                    "onCompleted": [
                      {
                        "id": "mark_sale_won",
                        "automation": "sales.markWon.v1",
                        "input": {},
                        "explainer": "Signing is when this pipeline counts the sale as won. Move this to the deposit, or any other step, to count it there instead."
                      },
                      {
                        "id": "activate_signed_scopes",
                        "automation": "scopes.activateFromProposal.v1",
                        "input": {},
                        "explainer": "When the customer signs, the project moves onto the production board for the work they bought and the sales pipeline wraps up."
                      }
                    ]
                  },
                  "external_triggers": [
                    {
                      "event": "proposal.signed",
                      "transition": "completed"
                    }
                  ]
                },
                {
                  "id": "collect_sales_deposit",
                  "title": "Collect deposit",
                  "terminology_key": "work.task",
                  "actionable": true,
                  "show_in_todo_list": true,
                  "depends_on": [
                    "sign_sales_proposal"
                  ],
                  "external_triggers": [
                    {
                      "event": "payment.received",
                      "transition": "completed",
                      "conditions": {
                        "payload.payment_kind": "deposit"
                      },
                      "explainer": "Receiving the deposit completes the sales pipeline."
                    }
                  ]
                }
              ]
            }
          ]
