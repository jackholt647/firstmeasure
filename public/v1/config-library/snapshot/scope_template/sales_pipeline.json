                    ],
                    "onSkipped": [
                      {
                        "id": "remove_skipped_new_lead_call",
                        "automation": "crm.callLists.remove.v1",
                        "input": {}
                      }
                    ],
                    "onCanceled": [
                      {
                        "id": "remove_canceled_new_lead_call",
