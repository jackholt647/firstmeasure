                          "channel": "passive",
                          "passive": true,
                          "manual_dismissible": true,
                          "push": false,
                          "target_role_ids": [
                            "sales_appointments"
                          ],
                          "frontend_action": {
                            "kind": "open_project",
                            "project_id": "{{project.id}}"
                          },
                          "context": {
                            "project_id": "{{project.id}}"
                          }
                        },
                        "explainer": "After a sales appointment wraps up, we ask the salesperson how it went."
                      }
                    ]
                  },
                  "external_triggers": [
                    {
                      "event": "project.event.completed",
                      "transition": "completed",
                      "conditions": {
                        "payload.event_type_default_id": "sales_appointment"
