                  "metadata": {
                    "kind": "complete_sales_appointment"
                  }
                },
                {
                  "id": "sales_appointment_completed",
                  "title": "Sales appointment finished",
                  "terminology_key": "work.task",
                  "actionable": false,
                  "show_in_todo_list": false,
