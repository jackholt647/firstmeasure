            "project.photos",
            "project.docs",
            "project.materials",
            "project.customer_portal",
            "project.money",
            "project.checklists"
          ],
          "pills": {
            "project.photos": "new",
            "project.docs": "new",
            "project.materials": "new",
            "project.customer_portal": "new"
          }
        },
