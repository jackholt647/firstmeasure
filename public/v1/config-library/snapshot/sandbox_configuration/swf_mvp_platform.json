    "setup": [
      {
        "action": "sandbox.scopeTemplate.install",
        "input": {
          "template_id": "generic_roofing",
          "from": "roof_replacement",
          "template": {
            "name": "Roofing",
            "description": "A roof job that moves through its stages as the report and documents are made.",
            "details": "New project, Measurements ordered, Measurements received, Proposal created and Materials created. Each stage's to-do finishes itself when the next step happens; you can also tick it or move the card by hand. Measurements use the roofing schema.",
            "work_plan": {
              "title": "Roofing",
              "terminology": {
                "phase": "Phase",
                "stage": "Stage",
                "task": "To-do",
                "board": "Board"
              },
              "metadata": {
                "board_color": "#dc2626",
                "canceled_column": {
                  "id": "cancelled",
                  "title": "Cancelled",
                  "color": "#667085"
                }
              },
              "root_nodes": [
                {
                  "id": "roofing_phase",
                  "title": "Roofing",
                  "terminology_key": "work.phase",
                  "completion_mode": "all_children",
                  "children": [
                    {
                      "id": "new_project",
                      "title": "New project",
                      "terminology_key": "work.stage",
                      "completion_mode": "all_children",
                      "metadata": {
                        "color": "#667085"
                      },
                      "children": [
                        {
                          "id": "order_report",
                          "title": "Order measurements",
                          "terminology_key": "work.task",
                          "actionable": true,
                          "external_triggers": [
                            {
                              "id": "report_ordered",
                              "event": "measurement.report.ordered",
                              "transition": "completed",
                              "explainer": "Done when this happens on the project."
                            },
                            {
                              "id": "report_delivered",
                              "event": "measurement.report.completed",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            },
                            {
                              "id": "proposal_document",
                              "event": "document.created",
                              "conditions": {
                                "payload.document_type": "proposal"
                              },
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            },
                            {
                              "id": "proposal",
                              "event": "proposal.created",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            },
                            {
                              "id": "materials_created",
                              "event": "material.lines.created",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "report_ordered",
                      "title": "Measurements ordered",
                      "terminology_key": "work.stage",
                      "completion_mode": "all_children",
                      "depends_on": [
                        "new_project"
                      ],
                      "metadata": {
                        "color": "#0e7490"
                      },
                      "children": [
                        {
                          "id": "receive_report",
                          "title": "Receive the measurements",
                          "terminology_key": "work.task",
                          "actionable": true,
                          "external_triggers": [
                            {
                              "id": "report_delivered",
                              "event": "measurement.report.completed",
                              "transition": "completed",
                              "explainer": "Done when this happens on the project."
                            },
                            {
                              "id": "proposal_document",
                              "event": "document.created",
                              "conditions": {
                                "payload.document_type": "proposal"
                              },
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            },
                            {
                              "id": "proposal",
                              "event": "proposal.created",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            },
                            {
                              "id": "materials_created",
                              "event": "material.lines.created",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "report_delivered",
                      "title": "Measurements received",
                      "terminology_key": "work.stage",
                      "completion_mode": "all_children",
                      "depends_on": [
                        "report_ordered"
                      ],
                      "metadata": {
                        "color": "#7c3aed"
                      },
                      "children": [
                        {
                          "id": "create_proposal",
                          "title": "Create the proposal",
                          "terminology_key": "work.task",
                          "actionable": true,
                          "external_triggers": [
                            {
                              "id": "proposal_document",
                              "event": "document.created",
                              "conditions": {
                                "payload.document_type": "proposal"
                              },
                              "transition": "completed",
                              "explainer": "Done when this happens on the project."
                            },
                            {
                              "id": "proposal",
                              "event": "proposal.created",
                              "transition": "completed",
                              "explainer": "Done when this happens on the project."
                            },
                            {
                              "id": "materials_created",
                              "event": "material.lines.created",
                              "transition": "completed",
                              "explainer": "A later step happened first, so this one is done too."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "proposal_created",
                      "title": "Proposal created",
                      "terminology_key": "work.stage",
                      "completion_mode": "all_children",
                      "depends_on": [
                        "report_delivered"
                      ],
                      "metadata": {
                        "color": "#ea580c"
                      },
                      "children": [
                        {
                          "id": "create_materials",
                          "title": "Create the materials",
                          "terminology_key": "work.task",
                          "actionable": true,
                          "external_triggers": [
                            {
                              "id": "materials_created",
                              "event": "material.lines.created",
                              "transition": "completed",
                              "explainer": "Done when this happens on the project."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "materials_created",
                      "title": "Materials created",
                      "terminology_key": "work.stage",
                      "completion_mode": "all_children",
                      "depends_on": [
                        "proposal_created"
                      ],
                      "metadata": {
                        "color": "#16a34a"
                      },
                      "children": [
                        {
                          "id": "review_materials",
                          "title": "Review the materials",
                          "terminology_key": "work.task",
                          "actionable": true
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "metadata": {
              "configuration": "mvp-platform"
            }
          }
        },
        "on_error": "stop",
        "note": "Generic Roofing: a roof job whose board follows the report and the documents."
      },
      {
        "action": "sandbox.intakeRouting.setDefault",
        "input": {
          "template_id": "generic_roofing"
        },
        "on_error": "stop"
      },
      {
        "action": "sandbox.scopeFlags.only",
        "input": {
          "template_ids": [
            "generic_roofing"
          ]
        },
        "on_error": "stop"
      }
    ]
  }
