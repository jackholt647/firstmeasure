{
  "kind": "automation_rule_default",
  "id": "platform_notify_new_lead",
  "revision": 1,
  "sha256": "34b86ca60cb932ded03797ac8b09b3eafad5a6e4d28de57b83ec6f36b3ce8e4d",
  "title": "Tell the sales team about a new lead",
  "updated_at": "2026-10-27T23:15:49.043Z",
  "updated_by": "generator",
  "data": {
    "id": "platform_notify_new_lead",
    "sort_order": 0,
    "enabled": true,
    "title": "Tell the sales team about a new lead",
    "explainer": "When a lead arrives from a source that names nobody to tell, we notify inside sales and appointment setters. Clicking it opens the lead.",
    "customer_visible": true,
    "event": "lead.received",
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "payload.notice.notify",
          "operator": "not_equals",
          "value": "false"
        },
        {
          "field": "payload.notice.target_role_ids",
          "operator": "is_missing"
        }
      ]
    },
    "automation": "notification.create.v1",
    "input": {
      "id": "notification_new_lead_{{project.id}}",
      "title": "{{event.payload.notice.title}}",
      "body": "{{event.payload.notice.body}}",
      "target_role_ids": [
        "inside_sales",
        "sales_appointments"
      ],
      "push": true,
      "source": "{{event.payload.notice.source}}",
      "context": {
        "lead_source": "{{event.payload.source_kind}}"
      },
      "frontend_action": {
        "kind": "open_project",
        "project_id": "{{project.id}}",
        "project_tab": "overview"
      }
    }
  }
}
