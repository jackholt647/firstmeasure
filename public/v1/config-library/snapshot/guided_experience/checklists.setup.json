      {
        "id": "default",
        "weight": 1,
        "when": {
          "match": "any",
          "rules": [
            {
              "field": "organization.industry",
              "operator": "is_missing"
            },
            {
              "field": "organization.industry",
              "operator": "not_in",
              "value": [
