      {
        "kind": "tab_opened",
        "tab": "project.checklists",
        "once": true,
        "delay_ms": 600
      }
    ],
    "variants": [
      {
        "id": "default",
        "weight": 1,
        "when": {
          "match": "any",
          "rules": [
            {
              "field": "organization.industry",
              "operator": "is_missing"
            },
            {
              "field": "organization.industry",
              "operator": "not_in",
              "value": [
                "roofing",
                "exteriors",
                "roofing_and_exteriors"
              ]
            }
          ]
        },
        "content": {}
      },
      {
        "id": "roofing",
        "weight": 1,
        "when": {
          "field": "organization.industry",
          "operator": "in",
          "value": [
            "roofing",
            "exteriors",
            "roofing_and_exteriors"
          ]
