{
  "kind": "guided_experience",
  "id": "checklists.setup",
  "revision": 5,
  "sha256": "7431651f607dc6def77f015a11fab4595ebcd71fb3596f251bf0ad442f92ac49",
  "title": "Set up checklists",
  "updated_at": "2026-11-18T22:01:27.438Z",
  "updated_by": "key:ck_1e1f09bdc222484f agents:fm-agents-1",
  "data": {
    "id": "checklists.setup",
    "version": 1,
    "kind": "modal",
    "scope": "organization",
    "salt": "checklists-v1",
    "title": {
      "key": "gx_cl_setup_title",
      "text": "Set up checklists"
    },
    "description": {
      "key": "gx_cl_setup_description_v3",
      "text": "Choose your default checklists (crew safety, work completion, a customer punch list), make each one yours by typing or by voice, and every new project starts with them."
    },
    "tab": "project.checklists",
    "eligibility": {
      "capabilities": [
        "apps.checklists"
      ],
      "permissions": [
        "manage_projects"
      ]
    },
    "triggers": [
      {
        "kind": "tab_opened",
        "tab": "project.checklists",
        "once": true,
        "delay_ms": 600
      }
    ],
    "variants": [
      {
        "id": "default",
        "weight": 1,
        "when": {
          "match": "any",
          "rules": [
            {
              "field": "organization.industry",
              "operator": "is_missing"
            },
            {
              "field": "organization.industry",
              "operator": "not_in",
              "value": [
                "roofing",
                "exteriors",
                "roofing_and_exteriors"
              ]
            }
          ]
        },
        "content": {}
      },
      {
        "id": "roofing",
        "weight": 1,
        "when": {
          "field": "organization.industry",
          "operator": "in",
          "value": [
            "roofing",
            "exteriors",
            "roofing_and_exteriors"
          ]
        },
        "content": {
          "use_cases": {
            "use_cases": [
              {
                "id": "crew_safety",
                "icon": "fa-helmet-safety",
                "label": {
                  "key": "gx_cl_uc_safety_label_v2",
                  "text": "Crew safety"
                },
                "description": {
                  "key": "gx_cl_uc_safety_body_v2",
                  "text": "Checked and signed before work starts."
                },
                "checklist": {
                  "title": "Crew safety",
                  "description": "Confirmed by the crew before work starts.",
                  "audience": "crew",
                  "crew_editable": false,
                  "signature_required": true,
                  "customer": "none",
                  "items": [
                    {
                      "title": "Fall protection anchors installed and inspected"
                    },
                    {
                      "title": "Harnesses and lanyards checked"
                    },
                    {
                      "title": "Ladders set at the right angle and tied off"
                    },
                    {
                      "title": "Power lines and skylights marked"
                    },
                    {
                      "title": "Ground area under the roof edge marked off"
                    },
                    {
                      "title": "First aid kit and fire extinguisher on site"
                    }
                  ]
                }
              },
              {
                "id": "work_completion",
                "icon": "fa-flag-checkered",
                "label": {
                  "key": "gx_cl_uc_done_label",
                  "text": "Work completion"
                },
                "description": {
                  "key": "gx_cl_uc_done_body_v2",
                  "text": "What must be done before the job is finished."
                },
                "checklist": {
                  "title": "Work completion",
                  "description": "Finished before the job is closed out.",
                  "audience": "crew",
                  "crew_editable": true,
                  "signature_required": false,
                  "customer": "none",
                  "items": [
                    {
                      "title": "Underlayment and ice and water shield installed"
                    },
                    {
                      "title": "Flashing at walls, chimneys and pipes finished"
                    },
                    {
                      "title": "Ridge vent and caps installed"
                    },
                    {
                      "title": "Drip edge and gutters checked"
                    },
                    {
                      "title": "Photos of every slope taken"
                    },
                    {
                      "title": "Dumpster removed and site cleaned up"
                    }
                  ]
                }
              },
              {
                "id": "punchlist",
                "icon": "fa-handshake",
                "label": {
                  "key": "gx_cl_uc_punch_label",
                  "text": "Customer punch list"
                },
                "description": {
                  "key": "gx_cl_uc_punch_body_v2",
                  "text": "Your customer ticks it off to sign off on the job."
                },
                "checklist": {
                  "title": "Customer punch list",
                  "description": "Walked with the customer at the end of the job.",
                  "audience": "crew",
                  "crew_editable": false,
                  "signature_required": false,
                  "customer": "complete",
                  "items": []
                },
                "selected": false
              }
            ]
          }
        }
      }
    ],
    "requires": [
      "company.type"
    ],
    "steps": [
      {
        "id": "use_cases",
        "widget": "module",
        "module": "/libraries/guided-experiences/checklists-setup.js?v=20261118-fm600",
        "requires": [],
        "title": {
          "key": "gx_cl_uc_title_v2",
          "text": "Which checklists do you want?"
        },
        "subtitle": {
          "key": "gx_cl_uc_subtitle_v4",
          "text": "These become your default checklists: every new project starts with them."
        },
        "say": [],
        "options": {
          "use_cases": [
            {
              "id": "crew_safety",
              "icon": "fa-helmet-safety",
              "label": {
                "key": "gx_cl_uc_safety_label_v2",
                "text": "Crew safety"
              },
              "description": {
                "key": "gx_cl_uc_safety_body_v2",
                "text": "Checked and signed before work starts."
              },
              "checklist": {
                "title": "Crew safety",
                "description": "Confirmed by the crew before work starts.",
                "audience": "crew",
                "crew_editable": false,
                "signature_required": true,
                "customer": "none",
                "items": [
                  {
                    "title": "Hazards reviewed with the whole crew"
                  },
                  {
                    "title": "Hard hats, safety glasses and gloves on"
                  },
                  {
                    "title": "Ladders set, tied off and inspected"
                  },
                  {
                    "title": "Work area marked off"
                  },
                  {
                    "title": "First aid kit and fire extinguisher on site"
                  }
                ]
              }
            },
            {
              "id": "work_completion",
              "icon": "fa-flag-checkered",
              "label": {
                "key": "gx_cl_uc_done_label",
                "text": "Work completion"
              },
              "description": {
                "key": "gx_cl_uc_done_body_v2",
                "text": "What must be done before the job is finished."
              },
              "checklist": {
                "title": "Work completion",
                "description": "Finished before the job is closed out.",
                "audience": "crew",
                "crew_editable": true,
                "signature_required": false,
                "customer": "none",
                "items": [
                  {
                    "title": "All work in the scope is done"
                  },
                  {
                    "title": "Photos of the finished work taken"
                  },
                  {
                    "title": "Site cleaned up"
                  },
                  {
                    "title": "Tools and equipment packed out"
                  },
                  {
                    "title": "Office told the job is finished"
                  }
                ]
              }
            },
            {
              "id": "punchlist",
              "icon": "fa-handshake",
              "label": {
                "key": "gx_cl_uc_punch_label",
                "text": "Customer punch list"
              },
              "description": {
                "key": "gx_cl_uc_punch_body_v2",
                "text": "Your customer ticks it off to sign off on the job."
              },
              "checklist": {
                "title": "Customer punch list",
                "description": "Walked with the customer at the end of the job.",
                "audience": "crew",
                "crew_editable": false,
                "signature_required": false,
                "customer": "complete",
                "items": []
              },
              "selected": false
            }
          ],
          "note": {
            "key": "gx_cl_uc_note_v3",
            "text": "Next, you’ll see each one and make it yours, by typing or by voice."
          }
        },
        "selects": [
          "checklist_use_cases",
          "checklist_definitions"
        ],
        "required": true,
        "next": {
          "branches": [
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "crew_safety"
              },
              "to": "edit_crew_safety"
            },
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "work_completion"
              },
              "to": "edit_work_completion"
            },
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "punchlist"
              },
              "to": "edit_punchlist"
            }
          ],
          "otherwise": "review"
        }
      },
      {
        "id": "edit_crew_safety",
        "widget": "module",
        "module": "/libraries/guided-experiences/checklists-setup.js?v=20261118-fm600",
        "requires": [],
        "title": {
          "key": "gx_cl_edit_safety_title",
          "text": "Here’s your crew safety checklist"
        },
        "subtitle": {
          "key": "gx_cl_edit_subtitle",
          "text": "A default checklist: every new project starts with it. Lists you make on a project are just for that project."
        },
        "say": [],
        "options": {
          "mode": "edit",
          "use_case": "crew_safety",
          "lead_first": {
            "key": "gx_cl_edit_lead_first",
            "text": "This is one of your default checklists: every new project starts with it. Make it fit how you work."
          },
          "lead_next": {
            "key": "gx_cl_edit_lead_next",
            "text": "Now set up your next default checklist. Change what you need, then continue."
          },
          "hint_next": {
            "key": "gx_cl_edit_hint_next",
            "text": "Press Dictate and say what to add, or type it below."
          },
          "tip_done": {
            "key": "gx_cl_edit_tip_done",
            "text": "Change any item by typing on it, or dictate again to add more."
          },
          "tip_say": {
            "key": "gx_cl_edit_safety_say",
            "text": "Say what to add, like “check the ladder feet and the tie-off points”."
          }
        },
        "selects": [
          "checklist_definitions"
        ],
        "required": true,
        "next": {
          "branches": [
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "work_completion"
              },
              "to": "edit_work_completion"
            },
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "punchlist"
              },
              "to": "edit_punchlist"
            }
          ],
          "otherwise": "review"
        }
      },
      {
        "id": "edit_work_completion",
        "widget": "module",
        "module": "/libraries/guided-experiences/checklists-setup.js?v=20261118-fm600",
        "requires": [],
        "title": {
          "key": "gx_cl_edit_done_title",
          "text": "Here’s your work completion checklist"
        },
        "subtitle": {
          "key": "gx_cl_edit_subtitle",
          "text": "A default checklist: every new project starts with it. Lists you make on a project are just for that project."
        },
        "say": [],
        "options": {
          "mode": "edit",
          "use_case": "work_completion",
          "lead_first": {
            "key": "gx_cl_edit_lead_first",
            "text": "This is one of your default checklists: every new project starts with it. Make it fit how you work."
          },
          "lead_next": {
            "key": "gx_cl_edit_lead_next",
            "text": "Now set up your next default checklist. Change what you need, then continue."
          },
          "hint_next": {
            "key": "gx_cl_edit_hint_next",
            "text": "Press Dictate and say what to add, or type it below."
          },
          "tip_done": {
            "key": "gx_cl_edit_tip_done",
            "text": "Change any item by typing on it, or dictate again to add more."
          },
          "tip_say": {
            "key": "gx_cl_edit_done_say",
            "text": "Say what to add, like “pick up every nail and take photos of the finished work”."
          }
        },
        "selects": [
          "checklist_definitions"
        ],
        "required": true,
        "next": {
          "branches": [
            {
              "when": {
                "field": "selections.checklist_use_cases",
                "operator": "contains",
                "value": "punchlist"
              },
              "to": "edit_punchlist"
            }
          ],
          "otherwise": "review"
        }
      },
      {
        "id": "edit_punchlist",
        "widget": "module",
        "module": "/libraries/guided-experiences/checklists-setup.js?v=20261118-fm600",
        "requires": [],
        "title": {
          "key": "gx_cl_edit_punch_title",
          "text": "Here’s your customer punch list"
        },
        "subtitle": {
          "key": "gx_cl_edit_subtitle",
          "text": "A default checklist: every new project starts with it. Lists you make on a project are just for that project."
        },
        "say": [],
        "options": {
          "mode": "edit",
          "use_case": "punchlist",
          "lead_first": {
            "key": "gx_cl_edit_lead_first",
            "text": "This is one of your default checklists: every new project starts with it. Make it fit how you work."
          },
          "lead_next": {
            "key": "gx_cl_edit_lead_next",
            "text": "Now set up your next default checklist. Change what you need, then continue."
          },
          "hint_next": {
            "key": "gx_cl_edit_hint_next",
            "text": "Press Dictate and say what to add, or type it below."
          },
          "tip_done": {
            "key": "gx_cl_edit_tip_done",
            "text": "Change any item by typing on it, or dictate again to add more."
          },
          "tip_say": {
            "key": "gx_cl_edit_punch_say",
            "text": "Say what to add, like “walk the yard together and check the gutters drain”."
          },
          "empty": {
            "key": "gx_cl_edit_punch_empty",
            "text": "It starts empty. Add what you always walk through with your customer, or leave it empty and fill it in on each job."
          }
        },
        "selects": [
          "checklist_definitions"
        ],
        "required": true
      },
      {
        "id": "review",
        "widget": "module",
        "module": "/libraries/guided-experiences/checklists-setup.js?v=20261118-fm600",
        "requires": [],
        "title": {
          "key": "gx_cl_review_title",
          "text": "Review your default checklists"
        },
        "subtitle": {
          "key": "gx_cl_review_subtitle",
          "text": "Run this setup again any time to change them."
        },
        "say": [],
        "options": {
          "mode": "review",
          "note": {
            "key": "gx_cl_review_note",
            "text": "Going forward, every new project starts with these {count} checklists. Lists you make on a project are just for that project."
          }
        },
        "selects": [],
        "required": true
      }
    ],
    "completion": {
      "action": {
        "id": "checklists.setup.apply",
        "target": "project",
        "input": {}
      },
      "screen": "none",
      "say": [],
      "then": [
        {
          "play": "checklists.punchlist_tutorial"
        },
        {
          "play": "checklists.tab_tutorial"
        }
      ]
    },
    "replayable": true,
    "reveal": []
  }
}
