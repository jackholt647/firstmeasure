                "checklist": {
                  "title": "Customer punch list",
                  "description": "Walked with the customer at the end of the job.",
                  "audience": "crew",
                  "crew_editable": false,
                  "signature_required": false,
                  "customer": "complete",
                  "items": [
                    {
                      "title": "Walk the finished roof and gutters with the customer"
                    },
                    {
                      "title": "Magnetic sweep done: no nails left in the yard or driveway"
                    },
                    {
                      "title": "Gutters and downspouts cleared of debris"
                    },
                    {
                      "title": "Landscaping and siding checked for damage"
                    },
                    {
                      "title": "Customer happy with the finished roof"
