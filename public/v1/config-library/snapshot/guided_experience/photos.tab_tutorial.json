    "requires": [],
    "steps": [
      {
        "id": "intro",
        "title": {
          "key": "gx_pt_intro_title",
          "text": "Welcome to Photos"
        },
        "body": {
          "key": "gx_pt_intro_body",
          "text": "Every photo and video for this project lives here. Here's a quick look around."
        },
        "targets": [],
        "placement": "center",
        "advance": "next",
        "wait_ms": 1500
      },
      {
        "id": "upload",
        "title": {
          "key": "gx_pt_upload_title",
          "text": "Upload"
        },
        "body": {
          "key": "gx_pt_add_body",
          "text": "Add photos and videos from your computer, or take them with your phone's camera. You can pick several at once."
        },
        "targets": [
          "#rPhotoFeedMount [data-photo-feed-upload]",
          "#rPhotoUploadBtn",
          "#rPhotoUploadEmpty"
        ],
        "placement": "auto",
        "advance": "next",
        "wait_ms": 1500
      },
      {
        "id": "open",
        "title": {
          "key": "gx_pt_open_title",
          "text": "Open a photo"
        },
        "body": {
          "key": "gx_pt_gallery_body",
          "text": "Click a photo to open it. From there you can mark it up, comment on it or share it to the customer's portal."
        },
        "targets": [
          "#rPhotoFeedMount [data-photo-feed-dynamic]",
          "#rPhotoGridOnly"
        ],
        "placement": "auto",
        "advance": "next",
        "wait_ms": 1500
      },
      {
        "id": "cover",
        "title": {
          "key": "gx_pt_cover_title",
          "text": "The cover photo"
        },
        "body": {
          "key": "gx_pt_cover_body",
          "text": "In an open photo, choose \"Set as cover photo\" to make it the project's picture. Its tile then shows a Cover pill."
        },
        "targets": [
          "#rPhotoFeedMount [data-project-cover-current]",
          "#rPhotoFeedMount [data-photo-feed-dynamic]",
          "#rPhotoGridOnly"
        ],
        "placement": "auto",
        "advance": "next",
        "wait_ms": 1500
      },
      {
        "id": "outro",
        "title": {
          "key": "gx_pt_outro_title",
          "text": "You're all set"
        },
        "body": {
          "key": "gx_pt_outro_body",
          "text": "Want this tour again? Ask the agent \"Show me the tutorial again\"."
        },
