{
  "name": "@firstmate/v1-host",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Node host for modular v1 APIs.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "node scripts/production_prepare.mjs",
    "start": "node scripts/production_start.mjs",
    "start:worker": "node --experimental-sqlite dist/src/firstmeasure_worker.js",
    "preflight": "node scripts/production_preflight.mjs",
    "preflight:offline": "node scripts/production_preflight.mjs --offline",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-sqlite --import tsx --test --test-force-exit tests/*.test.ts",
    "test:platform": "node --experimental-sqlite --import tsx --test --test-force-exit tests/platform-google-auth.test.ts tests/platform-phone-auth.test.ts tests/provider-route-auth.test.ts",
    "test:platform:google": "node --experimental-sqlite --import tsx --test --test-force-exit tests/platform-google-auth.test.ts",
    "test:platform:phone": "node --experimental-sqlite --import tsx --test --test-force-exit tests/platform-phone-auth.test.ts",
    "test:sms": "node --import tsx --test tests/telnyx-verify.test.ts",
    "test:platform:php": "node tests/php-lint.mjs",
    "test:internal": "node --experimental-sqlite --import tsx --test --test-force-exit tests/internal-permissions.test.ts tests/internal-teams.test.ts tests/manager-review.test.ts",
    "test:firstmeasure:postgres": "node --import tsx --test --test-force-exit tests/firstmeasure-postgres.test.ts",
    "test:firstmeasure:postgres:local": "node tests/run-embedded-postgres.mjs",
    "test:platform:postgres:local": "node tests/run-embedded-postgres.mjs tests/platform-postgres.test.ts",
    "test:cluster:postgres:local": "node tests/run-embedded-postgres.mjs tests/cluster-shared-stores.test.ts tests/cluster-state-migration.test.ts",
    "test:firstmeasure:sqlite": "node --experimental-sqlite --import tsx --test --test-force-exit tests/firstmeasure-sqlite-smoke.test.ts",
    "test:email:pull-spool": "node email/testing/pull-postmark-spool.mjs",
    "test:deployment": "npm run build && node --test tests/production-preflight.test.mjs",
    "test:smoke": "node --check ../libraries/platform-api/platform-api.js && node --check ../libraries/proposals-api/proposals-api.js && node --check ../libraries/materials-api/materials-api.js && node --check ../libraries/payments-api/payments-api.js && node --check ../libraries/email-api/email-api.js && node --check ../libraries/lead-intake-api/lead-intake-api.js && node --check ../libraries/canvassing-api/canvassing-api.js && node --check ../libraries/canvassing-app/canvassing-app.js && node --check ../libraries/lead-embed/firstmate-lead-embed.js && node --check ../libraries/platform-scheduling/platform-scheduling.js && node --check ../libraries/platform-schedule-view/platform-schedule-view.js && node --check ../libraries/platform-celebrations/platform-celebrations.js && node --check ../libraries/platform-notifications/platform-notifications.js && node --check ../libraries/platform-action-items/platform-action-items.js && node --check ../libraries/app-runtime/firstmate-embeddable-apps.js && node --check ../libraries/app-runtime/firstmate-app-context.js && node --check ../libraries/google-auth/firstmate-google-auth.js && node --check ../portal/scripts/core.js && node --check ../portal/scripts/topbar.js && node --check ../portal/scripts/project_viewer.js && npm run test:platform:php && npm run check && npm test && npm run test:deployment",
    "firstmeasure:reindex": "tsx src/scripts/firstmeasure_reindex.ts",
    "firstmeasure:stress": "tsx src/scripts/firstmeasure_stress.ts",
    "seed:manager-review-demo": "tsx src/scripts/seed_manager_review_demo.ts",
    "firstmeasure:postgres:verify": "tsx src/scripts/firstmeasure_postgres_verify.ts",
    "firstmeasure:artifacts:migrate": "node --experimental-sqlite --import tsx src/scripts/firstmeasure_artifacts_migrate.ts",
    "cluster:state:migrate": "tsx src/scripts/cluster_state_migrate.ts",
    "cluster:clone:sync": "node --experimental-sqlite --import tsx src/scripts/cluster_clone_sync.ts",
    "cluster:local:up": "docker compose -f ../../deploy/local-cluster/compose.yml up --build -d --wait",
    "cluster:local:down": "docker compose -f ../../deploy/local-cluster/compose.yml down",
    "cluster:local:reset": "docker compose -f ../../deploy/local-cluster/compose.yml down --volumes --remove-orphans",
    "cluster:local:verify": "node tests/cluster-acceptance.mjs",
    "firstmeasure:terminal-recovery": "tsx src/scripts/firstmeasure_terminal_state_recovery.ts",
    "public:firstmeasure:key": "tsx src/scripts/public_firstmeasure_key.ts",
    "platform:migration": "tsx src/scripts/platform_migration.ts",
    "backend:migration": "node --experimental-sqlite --import tsx src/scripts/backend_migration.ts",
    "backend:migration:dry-run": "node --experimental-sqlite --import tsx src/scripts/backend_migration.ts --mode dry-run",
    "backend:migration:fresh": "node --experimental-sqlite --import tsx src/scripts/backend_migration.ts --mode fresh --confirm-fresh",
    "backend:migration:validate": "node --experimental-sqlite --import tsx src/scripts/backend_migration.ts --mode validate",
    "platform:migration:dry-run": "tsx src/scripts/platform_migration.ts --mode dry-run",
    "platform:migration:fresh": "tsx src/scripts/platform_migration.ts --mode fresh --confirm-fresh",
    "platform:migration:validate": "tsx src/scripts/platform_migration.ts --mode validate",
    "platform:relink-identity": "tsx src/scripts/platform_relink_identity.ts",
    "platform:cutover:simulate": "node --experimental-sqlite --import tsx src/scripts/platform_cutover_simulation.ts --confirm-fresh",
    "platform:cutover:simulate:json": "node --experimental-sqlite --import tsx src/scripts/platform_cutover_simulation.ts --confirm-fresh --json",
    "platform:cutover:production": "node --experimental-sqlite --import tsx src/scripts/platform_production_cutover.ts --confirm-production",
    "platform:cutover:production:json": "node --experimental-sqlite --import tsx src/scripts/platform_production_cutover.ts --confirm-production --json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/http-proxy": "^11.6.1",
    "@fastify/multipart": "^9.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "geotiff": "^3.0.5",
    "google-auth-library": "^11.0.2",
    "jspdf": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.59.1",
    "sharp": "^0.35.3",
    "three": "^0.128.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.21.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
