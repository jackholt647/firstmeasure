{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "canvassing/**/*.ts",
    "communications/**/*.ts",
    "firstmeasure/**/*.ts",
    "lead-intake/**/*.ts",
    "materials/**/*.ts",
    "platform/**/*.ts",
    "proposals/**/*.ts",
    "pricebook/**/*.ts",
    "public-firstmeasure/**/*.ts",
    "weather/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "firstmeasure/dist",
    "firstmeasure/node_modules"
  ]
}
