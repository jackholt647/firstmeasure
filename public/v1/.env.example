# FirstMeasure PostgreSQL (use DigitalOcean private/VPC connection strings in production)
FIRSTMATE_ENV=production
V1_PORT=3101
FIRSTMEASURE_DATABASE_MODE=postgres
FIRSTMEASURE_SQLITE_BUSY_TIMEOUT_MS=15000
DATABASE_URL=postgresql://firstmeasure_app:REPLACE_ME@private-database-host:25060/firstmeasure?sslmode=require
DATABASE_ADMIN_URL=postgresql://doadmin:REPLACE_ME@private-database-host:25060/firstmeasure?sslmode=require
DATABASE_CA_CERT_PATH=/absolute/path/to/digitalocean-ca-certificate.crt
# With 44 web workers, one connection per process stays within the 97-connection
# limit of the current managed cluster while still allowing 44 concurrent queries.
POSTGRES_POOL_MAX=1
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
V1_WEB_WORKERS=8
V1_WORKER_HEARTBEAT_INTERVAL_MS=5000
V1_WORKER_HEARTBEAT_TIMEOUT_MS=30000
V1_WORKER_STARTUP_TIMEOUT_MS=120000
V1_WORKER_RESTART_BASE_DELAY_MS=250
V1_WORKER_RESTART_MAX_DELAY_MS=30000
V1_WORKER_CRASH_WINDOW_MS=60000
V1_WORKER_CRASH_LIMIT=20
V1_HEALTH_MONITOR_INTERVAL_MS=15000
V1_HEALTH_MONITOR_FAILURE_LIMIT=3
POSTGRES_STARTUP_WAIT_MS=1800000
# Non-leader web workers poll once per second during a one-time import. This
# avoids 44 workers creating unnecessary database chatter during cutover.
POSTGRES_STARTUP_POLL_MS=1000
POSTGRES_MIGRATION_BATCH_SIZE=500
POSTGRES_AUTO_MIGRATE=true
POSTGRES_ALLOW_EMPTY_IMPORT=false
# Old unreadable project folders are preserved and reported instead of blocking
# a cutover, up to this explicit safety limit.
POSTGRES_IMPORT_MAX_INVALID_MANIFESTS=100
# Public Google Identity Services OAuth client ID (no client secret is required).
GOOGLE_AUTH_CLIENT_ID=559396801204-jnlgd52pr4q45li0tp8lda4jakqg8ccu.apps.googleusercontent.com
# Server-side fallback when private/provider-keys.json is not used.
AZURE_MAPS_SUBSCRIPTION_KEY=

# Telnyx Verify for password-reset SMS. Keep real values in deployment secrets.
TELNYX_API_KEY=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_BASE_URL=https://api.telnyx.com/v2
TELNYX_REQUEST_TIMEOUT_MS=10000

# Existing payment credentials must remain deployment secrets; no live or test
# Stripe credential is embedded in application source.
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
