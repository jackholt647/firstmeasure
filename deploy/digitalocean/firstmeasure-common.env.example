# Install as /etc/firstmeasure/common.env with mode 0600. Never commit real values.
NODE_ENV=production
FIRSTMATE_ENV=production
FIRSTMEASURE_DATABASE_MODE=postgres
DATABASE_URL=postgresql://application-user:password@private-db-host:25060/firstmeasure
DATABASE_CA_CERT_PATH=/etc/firstmeasure/ca-certificate.crt
POSTGRES_POOL_MAX=1
POSTGRES_CONNECTION_LIMIT=97
POSTGRES_RESERVED_CONNECTIONS=10
POSTGRES_AUTO_MIGRATE=false
POSTGRES_ALLOW_EMPTY_IMPORT=true

FIRSTMEASURE_ARTIFACT_STORAGE=spaces
SPACES_ENDPOINT=https://region.digitaloceanspaces.com
SPACES_REGION=region
SPACES_BUCKET=private-firstmeasure
SPACES_ACCESS_KEY_ID=replace-me
SPACES_SECRET_ACCESS_KEY=replace-me
SPACES_PREFIX=production

PLATFORM_SESSION_SECRET=replace-with-one-shared-random-secret-of-at-least-32-characters
LEGACY_PROXY_SECRET=replace-with-a-different-shared-random-secret
FIRSTMEASURE_INTERNAL_API_SECRET=replace-me
PROVIDER_KEYS_PATH=/etc/firstmeasure/provider-keys.json

V1_HOST=127.0.0.1
V1_PORT=3101
V1_LOG_LEVEL=info
ROLLING_DRAIN_MS=25000
READINESS_CACHE_MS=10000
READINESS_DEPENDENCY_TIMEOUT_MS=2000
RELEASE_ID=replace-with-git-commit

# Disposable cache/import paths. Authoritative cluster data lives in
# PostgreSQL and Spaces, not in the checked-out release directory.
FIRSTMEASURE_STORAGE_ROOT=/var/cache/firstmeasure/projects
PLATFORM_STORAGE_ROOT=/var/cache/firstmeasure/platform
INTERNAL_STORAGE_ROOT=/var/cache/firstmeasure/internal
CRM_STORAGE_ROOT=/var/cache/firstmeasure/crm
CANVASSING_STORAGE_ROOT=/var/cache/firstmeasure/canvassing
PRICEBOOK_STORAGE_ROOT=/var/cache/firstmeasure/pricebook
WEATHER_STORAGE_ROOT=/var/cache/firstmeasure/weather
CODE_REPORT_STORAGE_ROOT=/var/cache/firstmeasure/code-reports
