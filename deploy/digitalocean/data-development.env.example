# Install as /etc/firstmeasure/data-environment.env on development nodes.
# This file deliberately overrides the data endpoints in common.env.
FIRSTMEASURE_DATA_ENVIRONMENT=development
FIRSTMEASURE_REQUIRE_DATA_ENVIRONMENT_MARKER=true
FIRSTMATE_ENV=staging
DATABASE_URL=postgresql://development-application-user:password@private-db-host:25060/firstmeasure_development
DATABASE_ADMIN_URL=postgresql://development-admin:password@private-db-host:25060/firstmeasure_development
SPACES_BUCKET=private-firstmeasure-development
SPACES_PREFIX=development
# Optional read-only base layer. Missing development objects are read from
# production, while all writes/deletes remain isolated under development.
SPACES_READ_FALLBACK_PREFIX=production
FIRSTMEASURE_CLONE_SYNC_STATE_PATH=/var/lib/firstmeasure-migration/development-artifacts.sqlite
POSTGRES_AUTO_MIGRATE=false
POSTGRES_ALLOW_EMPTY_IMPORT=false

# Development must use a distinct value and must not share production cookies.
PLATFORM_SESSION_COOKIE_NAME=fm_platform_session_development
PLATFORM_SESSION_SECRET=replace-with-development-only-random-secret

# Use separate provider credentials in development. Google APIs and Google
# OAuth may be real, but the credentials must be restricted to dev. Stripe is
# test-only and startup fails if a live secret is present.
STRIPE_TEST_MODE=true
STRIPE_BASE_URL=https://dev.1m8.ai/portal
STRIPE_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
META_CAPI_ACCESS_TOKEN=
PROVIDER_KEYS_PATH=/etc/firstmeasure/provider-keys-development.json

# Real development email is permitted, but external recipients are rewritten
# to this internal mailbox. Both Postmark and Gmail sends use the same guard.
DEVELOPMENT_EMAIL_MODE=rewrite
DEVELOPMENT_EMAIL_ALLOWED_DOMAINS=1m8.ai
DEVELOPMENT_EMAIL_CATCHALL=dev-catchall@1m8.ai

# SMS is blocked unless a number is explicitly added in E.164 form.
DEVELOPMENT_SMS_MODE=allowlist
DEVELOPMENT_SMS_ALLOWED_E164=
TELNYX_API_KEY=

# A development worker will refuse to start with a positive worker count until
# this explicit authorization is enabled after all provider checks pass.
DEVELOPMENT_WORKER_ENABLED=false
FIRSTMEASURE_JOB_WORKERS=0

# Used by the fixed development legacy node.
INTERNAL_STORAGE_ROOT=/var/lib/firstmeasure-legacy-development/current/v1/internal
CRM_STORAGE_ROOT=/var/lib/firstmeasure-legacy-development/current/v1/crm
COMMUNICATIONS_STORAGE_ROOT=/var/lib/firstmeasure-legacy-development/current/v1/communications
MEASURE_INTERNAL_TUTORIALS_ROOT=/var/lib/firstmeasure-legacy-development/current/tutorials
