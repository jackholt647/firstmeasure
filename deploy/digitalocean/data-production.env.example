# Install as /etc/firstmeasure/data-environment.env on production-candidate nodes.
FIRSTMEASURE_DATA_ENVIRONMENT=production
FIRSTMEASURE_REQUIRE_DATA_ENVIRONMENT_MARKER=true
DATABASE_URL=postgresql://production-application-user:password@private-db-host:25060/firstmeasure_production
DATABASE_ADMIN_URL=postgresql://production-admin:password@private-db-host:25060/firstmeasure_production
SPACES_BUCKET=private-firstmeasure-production
SPACES_PREFIX=production
FIRSTMEASURE_CLONE_SYNC_STATE_PATH=/var/lib/firstmeasure-migration/production-artifacts.sqlite
POSTGRES_AUTO_MIGRATE=false
POSTGRES_ALLOW_EMPTY_IMPORT=false
PLATFORM_SESSION_COOKIE_NAME=fm_platform_session
PLATFORM_SESSION_SECRET=replace-with-production-only-random-secret

# Used by the fixed production legacy node.
INTERNAL_STORAGE_ROOT=/var/lib/firstmeasure-legacy-production/current/v1/internal
CRM_STORAGE_ROOT=/var/lib/firstmeasure-legacy-production/current/v1/crm
COMMUNICATIONS_STORAGE_ROOT=/var/lib/firstmeasure-legacy-production/current/v1/communications
MEASURE_INTERNAL_TUTORIALS_ROOT=/var/lib/firstmeasure-legacy-production/current/tutorials
