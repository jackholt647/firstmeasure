# The legacy node is fixed and private. It uses PostgreSQL/Spaces for converted
# stores but retains one persistent disk for CRM SQLite and older PHP state.
DEPLOYMENT_TOPOLOGY=single
CLUSTER_NODE_ROLE=legacy
FIRSTMEASURE_PROCESS_ROLE=web
V1_HOST=0.0.0.0
V1_PORT=3101
V1_WEB_WORKERS=0
INTERNAL_STORAGE_ROOT=/var/lib/firstmeasure-legacy/v1/internal
CRM_STORAGE_ROOT=/var/lib/firstmeasure-legacy/v1/crm
COMMUNICATIONS_STORAGE_ROOT=/var/lib/firstmeasure-legacy/v1/communications
MEASURE_INTERNAL_TUTORIALS_ROOT=/var/lib/firstmeasure-legacy/tutorials
