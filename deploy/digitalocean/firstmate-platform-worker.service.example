# Preparation only. Do not install/enable until development deployment is approved.
[Unit]
Description=FirstMate platform automation worker
After=network-online.target firstmeasure-instance-identity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=firstmeasure
Group=firstmeasure
WorkingDirectory=/opt/firstmeasure/current/public/v1
EnvironmentFile=/etc/firstmeasure/common.env
EnvironmentFile=/etc/firstmeasure/platform-worker.env
EnvironmentFile=-/etc/firstmeasure/data-environment.env
EnvironmentFile=/opt/firstmeasure/current/release.env
Environment=INSTANCE_ID=%H
EnvironmentFile=-/run/firstmeasure/instance.env
ExecStart=/usr/bin/node --experimental-sqlite --max-old-space-size=3072 dist/src/platform_worker.js
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/firstmeasure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
