# Separate from the existing FirstMeasure worker. Verify aggregate pool/memory
# budgets before installation. The health endpoints bind only to loopback.
DEPLOYMENT_TOPOLOGY=cluster
CLUSTER_NODE_ROLE=worker
PLATFORM_PROCESS_ROLE=worker
FIRSTMEASURE_JOB_WORKERS=0
POSTGRES_POOL_MAX=4
PLATFORM_WORKER_PORT=3122
FIRSTMEASURE_STORAGE_ROOT=/var/cache/firstmeasure/projects
