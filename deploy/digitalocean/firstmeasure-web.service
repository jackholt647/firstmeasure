[Unit]
Description=FirstMeasure stateless web API
After=network-online.target firstmeasure-instance-identity.service
Wants=network-online.target firstmeasure-instance-identity.service

[Service]
Type=simple
User=firstmeasure
Group=firstmeasure
WorkingDirectory=/opt/firstmeasure/current/public/v1
EnvironmentFile=/etc/firstmeasure/common.env
EnvironmentFile=/etc/firstmeasure/web.env
EnvironmentFile=-/etc/firstmeasure/data-environment.env
EnvironmentFile=/opt/firstmeasure/current/release.env
Environment=INSTANCE_ID=%H
EnvironmentFile=-/run/firstmeasure/instance.env
ExecStart=/usr/bin/node --experimental-sqlite dist/src/server.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/firstmeasure
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
