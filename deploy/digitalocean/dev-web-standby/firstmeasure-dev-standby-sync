#!/usr/bin/env bash
# Keeps a standby copy of the dev web API (port 3202, nginx `backup`) one step behind the main
# service, so a release restart of firstmeasure-development-web never leaves nginx without an API.
#  1. Rebuild the standby unit from the main unit as it is now (every drop-in and env file), with
#     /etc/firstmeasure/development-web-standby.env last (V1_PORT=3202, one HTTP worker).
#  2. Once the main service answers ready on the active release, restart the standby onto it.
# Run by firstmeasure-dev-standby-sync.path (release switch) and .timer (fallback). Idempotent.
set -Eeuo pipefail
exec 9>/run/lock/firstmeasure-dev-standby-sync.lock
flock -n 9 || exit 0

main=firstmeasure-development-web
standby=firstmeasure-development-web-standby
unit=/etc/systemd/system/$standby.service
release="$(basename "$(readlink -f /opt/firstmeasure/current)")"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
{
  echo "# Generated by firstmeasure-dev-standby-sync from $main; do not edit."
  systemctl cat "$main" | grep -v '^# /' \
    | sed -e "s/^Description=.*/Description=FirstMeasure development web API standby (nginx backup on 3202)/"
  printf '\n[Service]\nEnvironmentFile=/etc/firstmeasure/development-web-standby.env\n'
} > "$tmp"
if ! cmp -s "$tmp" "$unit"; then
  install -m 0644 "$tmp" "$unit"
  systemctl daemon-reload
fi

ready() { # port -> release id when ready
  curl -fsS --max-time 3 "http://127.0.0.1:$1/v1/health/ready" 2>/dev/null \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d["release_id"] if d.get("ok") else "")' 2>/dev/null || true
}

[ "$(ready 3202)" = "$release" ] && systemctl is-active --quiet "$standby" && exit 0

# Never take the standby down while the main service is not serving the active release.
for _ in $(seq 1 120); do
  [ "$(ready 3201)" = "$release" ] && break
  sleep 1
done
[ "$(ready 3201)" = "$release" ] || { echo "main service not ready on $release; standby left as is"; exit 0; }

systemctl restart "$standby"
for _ in $(seq 1 60); do
  [ "$(ready 3202)" = "$release" ] && { echo "standby on $release"; exit 0; }
  sleep 1
done
echo "standby did not become ready on $release" >&2
exit 1
