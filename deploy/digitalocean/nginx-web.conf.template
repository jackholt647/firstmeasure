upstream firstmeasure_node { server 127.0.0.1:3101; keepalive 64; }
upstream firstmeasure_legacy_web { server __LEGACY_PRIVATE_IP__:80; keepalive 16; }

# A Host this site does not serve (scanners, spoofed Host headers) is closed
# without an answer. Only the load balancer's health checks and private
# (VPC/loopback) callers reach Node by address
# (deploy/digitalocean/security-php-nginx-20261024.md).
server {
    listen 80 default_server;
    server_name _;

    location ^~ /v1/health/ {
        proxy_pass http://firstmeasure_node;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ^~ /v1/ {
        allow 127.0.0.0/8;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://firstmeasure_node;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 300s;
    }
    location / { return 444; }
}

server {
    listen 80;
    server_name app.1m8.ai;
    root /opt/firstmeasure/current/public;
    index index.php index.html;
    client_max_body_size 256m;
    add_header X-Content-Type-Options nosniff always;

    location ^~ /v1/ {
        proxy_pass http://firstmeasure_node;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 300s;
        # Node sends its own nosniff; keep one copy.
        proxy_hide_header X-Content-Type-Options;
    }

    # Retired code, diagnostics and backups are never served.
    location ^~ /measure/internal/unused/ { return 404; }
    location ^~ /includes/ { return 404; }
    location ~ (^|/)unused/ { return 404; }
    location ~ /\.(?!well-known/) { return 404; }
    location ~* (\.(bak|orig|old|swp|save)|~)$ { return 404; }

    location ^~ /measure/internal/ {
        proxy_pass http://firstmeasure_legacy_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Content-Type-Options;
    }
    location ^~ /measure/sales/ {
        proxy_pass http://firstmeasure_legacy_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Content-Type-Options;
    }
    # The developer file manager (ide.php, api.php and their sign-in) is not
    # part of production. sync.php keeps its own signed-request check.
    location = /api.php { return 404; }
    location = /ide.php { return 404; }
    location = /login.php { return 404; }
    location = /add_user.php { return 404; }
    location = /auth.php { return 404; }
    location = /portal/symlink.php { return 404; }
    location = /sync.php {
        proxy_pass http://firstmeasure_legacy_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Content-Type-Options;
    }

    # PHP's data stores live under public/storage; only organization assets
    # (customer portal logos and files) are published from it.
    location ^~ /storage/measure/internal/organizations/ {
        location ~ \.php$ { return 404; }
        try_files $uri =404;
    }
    location ^~ /storage/ { return 404; }

    location /sites/ { try_files $uri $uri/ /sites/index.php?$query_string; }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        # Resolve the immutable release before PHP realpath/opcache lookup.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PROVIDER_KEYS_PATH /etc/firstmeasure/provider-keys.json;
        fastcgi_param FIRSTMEASURE_NODE_BASE_URL http://127.0.0.1:3101/v1/platform;
        fastcgi_param PLATFORM_SESSION_COOKIE_NAME __PLATFORM_SESSION_COOKIE_NAME__;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 300s;
    }
}
