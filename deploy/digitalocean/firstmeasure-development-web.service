[Unit]
Description=FirstMeasure isolated development stateless web API
After=network-online.target firstmeasure-instance-identity.service
Wants=network-online.target firstmeasure-instance-identity.service

[Service]
Type=simple
User=firstmeasure
Group=firstmeasure
WorkingDirectory=/opt/firstmeasure/current/public/v1
EnvironmentFile=/etc/firstmeasure/common.env
EnvironmentFile=/etc/firstmeasure/web.env
EnvironmentFile=/etc/firstmeasure/development.env
EnvironmentFile=/opt/firstmeasure/current/release.env
Environment=INSTANCE_ID=%H-development-web
Environment=V1_HOST=127.0.0.1
Environment=V1_PORT=3201
Environment=V1_WEB_WORKERS=2
Environment=CLUSTER_NODE_ROLE=web
Environment=FIRSTMEASURE_PROCESS_ROLE=web
Environment=FIRSTMEASURE_JOB_WORKERS=0
Environment=LEGACY_SERVICE_URL=http://10.124.16.5
ExecStart=/usr/bin/env V1_HOST=127.0.0.1 V1_PORT=3201 V1_WEB_WORKERS=2 CLUSTER_NODE_ROLE=web FIRSTMEASURE_PROCESS_ROLE=web FIRSTMEASURE_JOB_WORKERS=0 LEGACY_SERVICE_URL=http://10.124.16.5 /usr/bin/node --experimental-sqlite dist/src/server.js
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/firstmeasure-development
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
