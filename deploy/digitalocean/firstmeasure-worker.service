[Unit]
Description=FirstMeasure durable background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=firstmeasure
Group=firstmeasure
WorkingDirectory=/opt/firstmeasure/current/public/v1
EnvironmentFile=/etc/firstmeasure/common.env
EnvironmentFile=/etc/firstmeasure/worker.env
EnvironmentFile=/opt/firstmeasure/current/release.env
Environment=INSTANCE_ID=%H
ExecStart=/usr/bin/node --experimental-sqlite --max-old-space-size=4096 dist/src/firstmeasure_worker.js
Restart=always
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/firstmeasure
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
